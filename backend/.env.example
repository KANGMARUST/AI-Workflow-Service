APP_ENV=local
API_PREFIX=/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-server-side-key
UPSTAGE_API_KEY=replace-with-upstage-api-key
CORS_ORIGINS=http://localhost:5173

# Default: persistent SQLite + local original files under backend/.runtime.
# Supabase: use its PostgreSQL connection/pooler URL (not the HTTPS REST URL).
DATABASE_URL=
AUTO_CREATE_SCHEMA=false
# DATA_DIR=/app/.runtime
EXTRACTION_PROVIDER=auto
UPSTAGE_BASE_URL=https://api.upstage.ai/v2
QUOTE_EXTRACT_AGENT_ID=agt_PDRAagZCX2rzbqfEm7J5QA
QUOTE_EXTRACT_CONFIG_ID=3
QUOTE_COMPARE_AGENT_ID=agt_Tm6UnDBS47q2W3EJ5NEQKQ
QUOTE_COMPARE_CONFIG_ID=1
QUOTE_DRAFT_AGENT_ID=agt_Re8sxTcZDG3e5TDktLHQUD
QUOTE_DRAFT_CONFIG_ID=1
AGENT_TIMEOUT_SECONDS=180
MAX_UPLOAD_MB=20
MAX_DOCUMENT_PAGES=100
# Optional locally; required with APP_ENV=production. Frontend sends Bearer token.
API_TOKEN=
