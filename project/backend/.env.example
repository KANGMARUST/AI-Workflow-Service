HOST=127.0.0.1
PORT=8000
# Defaults: backend/storage and project/data
QUOTE_DATA_DIR=
QUOTE_SAMPLE_DIR=
# Leave blank for persistent SQLite. Supply a PostgreSQL/Supabase direct DB URL manually.
DATABASE_URL=
# AI credentials are entered by each user in the web API settings.
# Do not put developer/shared API keys in deployment environment variables.
# Defaults to included backend/models/korean_rec.onnx; no runtime download.
QUOTE_OCR_MODEL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
