                  "type": "string",
                  "description": "원본 작성일 YYYY-MM-DD"
                },
                "valid_until": {
                  "type": "string",
                  "description": "원본 유효기간"
                },
                "delivery": {
                  "type": "string",
                  "description": "명시된 납기"
                },
                "ship_to": {
                  "type": "string",
                  "description": "납품 장소"
                },
                "payment_terms": {
                  "type": "string",
                  "description": "원본 결제 조건"
                },
                "project_name": {
                  "type": "string",
                  "description": "원본 견적 제목"
                },
                "currency": {
                  "type": "string",
                  "description": "원본 통화"
                },
                "tax_note": {
                  "type": "string",
                  "description": "명시된 VAT 조건. 미기재를 추정하지 않는다"
                },
                "notes": {
                  "type": "string",
                  "description": "명시된 보증·설치·운송·특약·선택 조건을 원문 그대로 보존. 없으면 빈 문자열"
                },
                "items_json": {
                  "type": "string",
                  "description": "독립 품목을 추출한다. 일반 품목으로 확정할 근거가 없으면 판단 보류로 분류한다. 모든 품목을 순서대로 JSON 배열 문자열로 출력. 각 객체는 name,model,specification,unit,quantity,unit_price,amount,is_component,parent_index,option_group,option_choice,option_condition,original_text. 모델은 명시된 경우만 쓰고 미기재 값은 null/빈 문자열. parent_index는 0부터 시작하는 상위 품목 행 번호. quantity,unit_price,amount에는 숫자만, 통화는 currency에 쓴다. 같은 대체 선택 묶음은 같은 option_group을 쓰고 option_choice에 A/B 등 각 선택지, option_condition에 선택 조건 원문을 기록한다. 원문 금액을 계산하거나 옵션·구성품을 합산하지 않는다."
                },
                "subtotal": {
                  "type": "string",
                  "description": "원문에 직접 표시된 subtotal의 숫자만 출력. 미기재·선택 전 미확정이면 빈 문자열. 절대로 0으로 대신하지 않는다"
                },
                "tax": {
                  "type": "string",
                  "description": "원문에 직접 표시된 tax의 숫자만 출력. 미기재·선택 전 미확정이면 빈 문자열. 절대로 0으로 대신하지 않는다"
                },
                "total": {
                  "type": "string",
                  "description": "원문에 직접 표시된 total의 숫자만 출력. 미기재·선택 전 미확정이면 빈 문자열. 절대로 0으로 대신하지 않는다"
                },
                "tax_rate": {
                  "type": "string",
